# ============================================
# STUDYSPACE - GITATTRIBUTES
# Line ending configuration for consistent behavior across platforms
# ============================================

# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout (LF on Linux/Mac, CRLF on Windows)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Python files
*.py text eol=lf
*.pyi text eol=lf

# Configuration files
*.ini text eol=lf
*.toml text eol=lf
*.conf text eol=lf
*.config text eol=lf

# Shell scripts - always use LF
*.sh text eol=lf
*.bash text eol=lf

# SQL files
*.sql text eol=lf

# Docker files
Dockerfile text eol=lf
*.dockerfile text eol=lf
docker-compose*.yml text eol=lf

# Git files
.gitignore text eol=lf
.gitattributes text eol=lf
.gitmodules text eol=lf

# Documentation
*.md text eol=lf
*.rst text eol=lf
*.adoc text eol=lf

# Binary files - declare as binary (no line ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.mp3 binary
*.mp4 binary
*.zip binary
*.tar binary
*.gz binary
*.pdf binary

# Windows specific files - use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Force LF for these files regardless of platform
.editorconfig text eol=lf
.eslintrc* text eol=lf
.prettierrc* text eol=lf
tsconfig.json text eol=lf
package.json text eol=lf
package-lock.json text eol=lf
pyproject.toml text eol=lf
requirements.txt text eol=lf

