# Application Settings
APP_NAME=StudySpace
ENVIRONMENT=development  # development | production
DEBUG=True

# Database Configuration
DATABASE_URL=postgresql://admin:studyspace2024@localhost:5432/studyspace

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Comma-separated list of allowed origins
# Development (localhost sẽ được tự động cho phép)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Production example:
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://studyspace.com

# Audio Storage (Optional)
AUDIO_STORAGE_PATH=static/audio
MAX_AUDIO_FILE_SIZE=104857600  # 100MB in bytes
ALLOWED_AUDIO_FORMATS=.mp3,.wav,.ogg,.m4a,.aac

# AI/LLM API Keys (Optional)
OPENAI_API_KEY=
GEMINI_API_KEY="AIzaSyAHUk3PRMXFhgnCSJ7GzgspfGVEwJMGSXY"
